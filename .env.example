# Copiar a .env y completar. Nunca subir .env al repositorio.

# --- Entorno ---
NUXT_PUBLIC_SITE_ENV=development
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# Mostrar /_lab en un build de preview (en desarrollo siempre está activo)
NUXT_PUBLIC_ENABLE_LAB=false

# --- Formulario de cita (Fase 6) ---
NUXT_MAIL_PROVIDER=
NUXT_MAIL_API_KEY=
NUXT_MAIL_FROM=
NUXT_BOOKING_TO_EMAIL=
NUXT_TURNSTILE_SECRET_KEY=
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
NUXT_FORM_HMAC_SECRET=

# --- Pipeline 3D (solo herramientas locales, no lo usa la app) ---
# Ruta al ejecutable de Blender 5.2 LTS
BLENDER_BIN=
