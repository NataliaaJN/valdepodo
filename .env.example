# Copiar a .env y completar. Nunca subir .env al repositorio.

# --- Entorno ---
NUXT_PUBLIC_SITE_ENV=development
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# Mostrar /_lab en un build de preview (en desarrollo siempre está activo)
NUXT_PUBLIC_ENABLE_LAB=false

# --- Formulario de cita (Fase 6, spec 06 §3) ---
# Proveedor de correo: resend | brevo | console (solo desarrollo: no envía nada).
# Fuera de producción, si se deja vacío se usa `console` y Turnstile es opcional.
# En producción todo es obligatorio; si falta algo, /api/cita responde 503.
NUXT_MAIL_PROVIDER=
NUXT_MAIL_API_KEY=
# Remitente verificado en el proveedor, p. ej. "Valdepodo <citas@dominio.es>"
NUXT_MAIL_FROM=
# Buzón de la clínica que recibe las solicitudes
NUXT_BOOKING_TO_EMAIL=
NUXT_TURNSTILE_SECRET_KEY=
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
# Secreto largo y aleatorio para firmar el token de tiempo del formulario (p. ej. `openssl rand -hex 32`)
NUXT_FORM_HMAC_SECRET=

# --- Pipeline 3D (solo herramientas locales, no lo usa la app) ---
# Ruta al ejecutable de Blender 5.2 LTS
BLENDER_BIN=
