{
  "name": "valdepodo",
  "private": true,
  "type": "module",
  "description": "Web de Valdepodo, clínica de podología (Nuxt 4).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "3d:check-env": "node tools/blender/run-blender.mjs --check",
    "3d:test-cube": "node tools/blender/run-blender.mjs tools/blender/test_cube.py -- --config tools/blender/config/test-cube.json --out tools/out/test-cube.raw.glb",
    "3d:inspect": "node tools/blender/run-blender.mjs tools/blender/inspect_source.py -- --config tools/blender/config/foot.json",
    "3d:inspect-za": "node tools/blender/run-blender.mjs tools/blender/inspect_zanatomy.py -- --config tools/blender/config/foot.json",
    "3d:foot-validation": "node tools/blender/run-blender.mjs tools/blender/render_foot_validation.py -- --config tools/blender/config/foot.json",
    "3d:optimize": "node tools/assets/optimize.mjs",
    "3d:check": "node tools/assets/check-assets.mjs",
    "3d:smoke": "npm run 3d:test-cube && npm run 3d:optimize -- test-cube && npm run 3d:check"
  },
  "dependencies": {
    "@nuxt/fonts": "^1.2.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tresjs/cientos": "^5.10.1",
    "@tresjs/core": "^5.10.1",
    "gsap": "^3.15.1",
    "nuxt": "^4.6.4",
    "tailwindcss": "^4.3.5",
    "three": "^0.187.0",
    "vue": "^3.5.45",
    "vue-router": "^5.5.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.4.0",
    "@types/three": "^0.187.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "happy-dom": "^21.0.4",
    "meshoptimizer": "^1.3.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
